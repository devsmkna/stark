{
  "name": "stark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GUI locale che sostituisce la TUI degli agent AI",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node src/cli/offline-check.ts",
    "slice": "node src/cli/vertical-slice.ts",
    "build": "tsc -p tsconfig.json",
    "resume": "node src/cli/resume-check.ts",
    "takeover": "node src/cli/takeover-check.ts",
    "import": "node src/cli/import-check.ts",
    "queue": "node src/cli/queue-check.ts",
    "stark": "node src/cli/stark.ts",
    "stark:start": "node src/cli/stark.ts start",
    "stark:status": "node src/cli/stark.ts status",
    "stark:stop": "node src/cli/stark.ts stop",
    "stark:up": "node src/cli/stark.ts up",
    "stark:token": "node src/cli/stark.ts token",
    "stark:install": "node src/cli/stark.ts install",
    "daemon": "node src/cli/daemon-check.ts",
    "diff": "node src/cli/diff-live-check.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:check": "svelte-check --tsconfig ./ui/tsconfig.json",
    "icons": "node tools/gen-icons.mjs",
    "sonda": "node tools/sonda-telefono/server.mjs",
    "opencode": "node spike/opencode/p24-adapter.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "lucide-static": "^1.34.0",
    "playwright-core": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@opencode-ai/sdk": "^1.17.20",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "web-push": "^3.6.7"
  }
}
