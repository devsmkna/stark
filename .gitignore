# PromptOps context snapshot
.promptops/

# PromptOps session assets
.promptops-assets/

# --- Spike: artefatti riproducibili, NON versionare ---
# Contengono email, organizzazione e tipo di abbonamento (payload initialize),
# trascrizioni di sessione e percorsi assoluti della macchina.
spike/captures/
spike/sandbox/

# --- Segreti e configurazione locale ---
.env
.env.*
!.env.example
.claude/settings.local.json
# `.claude/skills/` invece va versionato: e' la skill dei todo, e sta li' perche' chi
# clona se la trovi attiva senza installare niente. Il resto di `.claude/` e' locale.
.claude/worktrees/
*.local.json

# --- Dipendenze e build ---
node_modules/
dist/
build/
.vite/
# Il lockfile del progetto e` `package-lock.json`: e` quello che usano l'installer e
# `stark update`. Un `yarn.lock` era entrato per sbaglio (56db151, generato su un Mac
# installando con yarn invece che con npm) e non portava niente che il primo non
# avesse gia` — le 17 dipendenze c'erano tutte. Faceva pero` danno: npm tiene in
# sincrono un `yarn.lock` se lo trova, quindi lo riscriveva a **ogni** `npm install` e
# per giunta secondo la piattaforma di chi lo eseguiva (darwin-arm64 ↔ linux-x64-musl),
# lasciando in `git status` modifiche che non erano di nessuno. Chi preferisce yarn
# sulla propria macchina puo` continuare: il file resta, semplicemente non viaggia.
yarn.lock

# --- Rumore ---
*.log
.DS_Store
